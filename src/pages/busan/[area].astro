---
import Layout from '../../layouts/Layout.astro';
const areaData={
'중구':{slug:'jung-gu',focus:'상가·사무실·생활 폐기물',places:['남포동','광복동','중앙동','부평동']},
'서구':{slug:'seo-gu',focus:'가정·이사·가구 수거',places:['동대신동','서대신동','암남동','충무동']},
'동구':{slug:'dong-gu',focus:'사무실·상가·이사 잔여물',places:['초량동','수정동','좌천동','범일동']},
'영도구':{slug:'yeongdo-gu',focus:'가정·상가·창고 정리',places:['남항동','영선동','청학동','동삼동']},
'부산진구':{slug:'busanjin-gu',focus:'사무실·상가·폐업 정리',places:['서면','부전동','전포동','가야동']},
'동래구':{slug:'dongnae-gu',focus:'가정·이사·사무집기 수거',places:['명륜동','온천동','사직동','안락동']},
'남구':{slug:'nam-gu',focus:'가정·사무실·상가 수거',places:['대연동','용호동','문현동','용당동']},
'북구':{slug:'buk-gu',focus:'가구·가전·이사 폐기물',places:['화명동','덕천동','구포동','만덕동']},
'해운대구':{slug:'haeundae-gu',focus:'아파트·사무실·상가 수거',places:['우동','중동','좌동','재송동']},
'사하구':{slug:'saha-gu',focus:'가정·사업장·창고 정리',places:['하단동','괴정동','다대동','장림동']},
'금정구':{slug:'geumjeong-gu',focus:'가정·상가·사무실 수거',places:['장전동','구서동','부곡동','남산동']},
'강서구':{slug:'gangseo-gu',focus:'사업장·공장·창고 대량수거',places:['명지동','대저동','녹산동','신호동']},
'연제구':{slug:'yeonje-gu',focus:'사무실·가정·이사 정리',places:['연산동','거제동']},
'수영구':{slug:'suyeong-gu',focus:'상가·가정·사무실 수거',places:['광안동','남천동','민락동','망미동']},
'사상구':{slug:'sasang-gu',focus:'공장·사업장·창고 폐기물',places:['괘법동','감전동','주례동','모라동']},
'기장군':{slug:'gijang-gun',focus:'가정·상가·사업장 수거',places:['기장읍','정관읍','일광읍','장안읍']}
};
export function getStaticPaths(){return Object.entries(areaData).map(([area,data])=>({params:{area:data.slug},props:{area,data}}))}
const {area,data}=Astro.props;
const keywords=[area+' 폐기물수거',area+' 가구수거',area+' 사무실폐기물수거',area+' 상가폐기물수거',area+' 폐업정리',area+' 대량폐기물수거'];
---
<Layout title={area+' 폐기물수거 | 올바른수거'} description={'부산 '+area+' 폐기물수거. '+data.focus+' 상담. 사진으로 빠르게 수거 상담을 받아보세요.'}>
<header class="local-header"><a class="brand" href="/"><span class="logo">🚚</span><span><b>올바른수거</b><small>부산 폐기물·불용품 수거 전문</small></span></a><a href="/" class="back">← 부산 전체지역</a><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a></header>
<main>
<section class="area-hero"><div><p>올바른수거 · 부산 {area}</p><h1>{area} 폐기물수거<br><em>빠르고 간편하게</em></h1><p>{data.focus}이 필요하다면 사진으로 먼저 상담해 보세요.</p><div class="actions"><a class="primary" href="#area-contact">사진으로 문의하기</a><a class="secondary" href="tel:01066484886">전화 상담하기</a></div></div><div class="image-placeholder area-main-image"><strong>{area} 대표 이미지</strong><span>추후 WebP 현장 이미지 교체</span></div></section>
<section class="section"><div class="section-head"><div><h2>{area} 주요 수거 서비스</h2><p>현장과 물품에 맞춰 필요한 수거 서비스를 상담합니다.</p></div></div><div class="keyword-grid">{keywords.map(k=><article><span>✓</span><strong>{k}</strong><p>사진과 수량을 알려주시면 빠르게 상담할 수 있습니다.</p></article>)}</div></section>
<section class="section local-places"><h2>{area} 주요 지역</h2><p>{data.places.join(' · ')} 등 {area} 전지역을 상담합니다.</p><div>{data.places.map(p=><span>{p} 폐기물수거</span>)}</div></section>
<section class="section"><div class="section-head"><div><h2>{area} 수거 사례</h2><p>실제 현장 이미지는 제작 후 순차적으로 교체합니다.</p></div></div><div class="cases">{[1,2,3,4].map(i=><article><div class="image-placeholder case-img"><span>{area} 현장 이미지 {i}</span></div><h3>{area} 수거 현장 {i}</h3><p>현장별 작업 내용을 독창적인 사례 콘텐츠로 구성할 예정입니다.</p></article>)}</div></section>
<section id="area-contact" class="contact"><p>{area}에서 처리가 어려운 물품이 있으신가요?</p><h2>사진을 보내주시면 수거 가능 여부를 빠르게 상담해 드립니다.</h2><div class="actions"><a class="primary" href="#">카카오톡 사진 문의</a><a class="secondary" href="tel:01066484886">☎ 010-6648-4886</a></div></section>
</main>
<footer><b>올바른수거</b><p>부산 {area} 폐기물·불용품 수거 상담</p></footer><div class="mobile-bar"><a href="tel:01066484886">☎ 전화문의</a><a href="#area-contact">● 카톡문의</a></div>
</Layout>