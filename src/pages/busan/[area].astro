'수영구':['상권 매장집기와 공동주택 가구를 구분','광안·민락의 상가 집기와 남천·망미의 가정 가구는 작업시간과 엘리베이터 등 서로 다른 조건을 확인합니다.'],
'사상구':['사업장·창고의 대량 정리를 우선 확인','감전·괘법의 사업장과 창고는 전체 적재 규모와 상차공간을, 주례·모라 생활권은 가구 이동조건을 중심으로 확인합니다.'],
'기장군':['넓은 생활권별 현장 유형을 먼저 확인','정관·일광의 공동주택 이사물품과 기장·장안의 상가·사업장 물품은 거리보다 현장 유형과 전체 물량을 먼저 확인합니다.']
};
const districtInsight=districtInsights[area];
const guide=guideProfiles[areaKinds[area]??'home'];
const districtBreadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
{'@type':'ListItem',position:1,name:'부산 폐기물수거'},
{'@type':'ListItem',position:2,name:area}
]};
const districtFaq={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
...guide.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})),
{'@type':'Question',name:'사진 상담에는 무엇을 보내면 좋나요?',acceptedAnswer:{'@type':'Answer',text:guide.service}}
]};
---
<Layout title={area+' 폐기물수거 | '+data.focus+' | 올바른수거'} description={'부산 '+area+' 폐기물수거 상담. '+intro}>
<header class="local-header"><a class="brand" href="/" aria-label="올바른수거 홈"><img class="brand-logo" src="/images/logo.png" alt="올바른수거" width="320" height="100" /></a><a href="/" class="back">← 부산 전체지역</a><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a></header>
<main>
<section class="area-hero district-hero"><div><p class="district-kicker">BUSAN · {area} COLLECTION GUIDE</p><h1>{area} 폐기물수거<br><em>{data.focus}</em></h1><p>{intro}</p><div class="district-facts"><span>사진으로 물품 확인</span><span>현장 이동조건 확인</span><span>{area} 지역별 안내</span></div><div class="actions"><a class="primary" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">사진으로 수거 상담</a><a class="secondary" href="tel:01066484886">☎ 전화 상담</a></div></div><div class="hero-chat district-chat" aria-label="올바른수거 사진 상담 예시">
