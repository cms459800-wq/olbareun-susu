---
import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){
const areaData={
'중구':{slug:'jung-gu',focus:'상가·사무실·생활 폐기물',places:['남포동','광복동','중앙동','부평동'],intro:'남포동과 광복동 상권부터 중앙동 업무지역까지 상가 집기와 사무실 불용품 정리 문의가 많은 지역입니다.',types:['상가 집기 정리','사무실 불용품','생활 폐기물']},
'서구':{slug:'seo-gu',focus:'가정·이사·가구 수거',places:['동대신동','서대신동','암남동','충무동'],intro:'동대신동·서대신동 주거지역의 이사 잔여물과 가구 정리, 암남동·충무동의 상가 불용품까지 현장별로 상담합니다.',types:['이사 잔여물','대형 가구','상가 불용품']},
'동구':{slug:'dong-gu',focus:'사무실·상가·이사 잔여물',places:['초량동','수정동','좌천동','범일동'],intro:'초량·범일 업무·상업지역의 사무집기와 매장 정리부터 수정동·좌천동의 생활 폐기물까지 폭넓게 상담합니다.',types:['사무실 집기','상가 정리','이사 잔여물']},
'영도구':{slug:'yeongdo-gu',focus:'가정·상가·창고 정리',places:['남항동','영선동','청학동','동삼동'],intro:'동삼동·청학동 주거지의 가구 정리와 남항동·영선동의 상가 및 창고 불용품 수거를 현장 조건에 맞춰 안내합니다.',types:['가정 가구 정리','상가 집기','창고 불용품']},
'부산진구':{slug:'busanjin-gu',focus:'사무실·상가·폐업 정리',places:['서면','부전동','전포동','가야동'],intro:'서면·전포 상권의 매장 정리부터 부전동 사무실 집기까지 상업시설 수거 상담에 초점을 맞춥니다.',types:['폐업 매장 정리','사무실 집기','카페·음식점 집기']},
'동래구':{slug:'dongnae-gu',focus:'가정·이사·사무집기 수거',places:['명륜동','온천동','사직동','안락동'],intro:'사직·안락 주거지역의 이사 정리와 온천·명륜 상권의 가구·집기 수거를 중심으로 상담합니다.',types:['이사 정리','가구·가전','상가·사무집기']},
'남구':{slug:'nam-gu',focus:'가정·사무실·상가 수거',places:['대연동','용호동','문현동','용당동'],intro:'대연·용호 주거지역의 가구·가전과 문현 업무지역의 사무집기, 용당동 사업장 불용품을 구분해 상담합니다.',types:['가정 가구·가전','사무실 집기','사업장 불용품']},
'북구':{slug:'buk-gu',focus:'가구·가전·이사 폐기물',places:['화명동','덕천동','구포동','만덕동'],intro:'화명·만덕의 아파트 가구·가전과 덕천·구포의 상가 집기, 이사 후 남은 물품 정리를 상담합니다.',types:['아파트 가구','가전 정리','이사 폐기물']},
'해운대구':{slug:'haeundae-gu',focus:'아파트·사무실·상가 수거',places:['우동','중동','좌동','재송동'],intro:'우동·좌동 주거지역의 가구·가전부터 센텀권 사무실 불용 집기까지 현장 유형에 맞춰 상담합니다.',types:['아파트 가구 정리','사무실 집기','상가 불용품']},
'사하구':{slug:'saha-gu',focus:'가정·사업장·창고 정리',places:['하단동','괴정동','다대동','장림동'],intro:'하단·괴정 생활권의 가정·상가 정리와 장림·다대 지역의 사업장·창고 불용품을 수량과 현장 여건에 맞춰 상담합니다.',types:['가정·상가 정리','사업장 불용품','창고 대량수거']},
'금정구':{slug:'geumjeong-gu',focus:'가정·상가·사무실 수거',places:['장전동','구서동','부곡동','남산동'],intro:'장전·부곡의 원룸·상가 정리와 구서·남산 주거지역의 가구, 사무실 집기 수거를 상황별로 안내합니다.',types:['원룸·이사 정리','가구 수거','상가·사무집기']},
'강서구':{slug:'gangseo-gu',focus:'사업장·공장·창고 대량수거',places:['명지동','대저동','녹산동','신호동'],intro:'명지 주거지역과 녹산·대저 사업장 특성을 함께 고려해 가정 정리부터 창고·사업장 대량 수거까지 안내합니다.',types:['사업장 폐기물','창고 정리','대량 집기 수거']},
'연제구':{slug:'yeonje-gu',focus:'사무실·가정·이사 정리',places:['연산동','거제동'],intro:'연산동 업무·상업지역의 사무실 집기와 거제동 주거지역의 이사·가구 정리를 중심으로 빠르게 상담합니다.',types:['사무실 불용품','이사 정리','가구·가전']},
'수영구':{slug:'suyeong-gu',focus:'상가·가정·사무실 수거',places:['광안동','남천동','민락동','망미동'],intro:'광안·민락 상권의 매장 집기와 남천·망미 주거지역의 가구·이사 잔여물을 현장 특성에 맞춰 상담합니다.',types:['상가·매장 집기','가정 가구','이사 잔여물']},
'사상구':{slug:'sasang-gu',focus:'공장·사업장·창고 폐기물',places:['괘법동','감전동','주례동','모라동'],intro:'감전동·괘법동의 사업장과 창고, 주례·모라 생활권의 가정 수거를 구분해 필요한 정리 방식을 안내합니다.',types:['공장·사업장 정리','창고 폐기물','사무집기']},
'기장군':{slug:'gijang-gun',focus:'가정·상가·사업장 수거',places:['기장읍','정관읍','일광읍','장안읍'],intro:'정관·일광 신도시권의 가정·이사 정리부터 기장·장안의 상가와 사업장 불용품까지 넓은 지역 특성을 고려해 상담합니다.',types:['아파트·이사 정리','상가 집기','사업장 불용품']}
};
return Object.entries(areaData).map(([area,data])=>({params:{area:data.slug},props:{area,data}}));
}
const {area,data}=Astro.props;
const intro=data.intro ?? `${area}의 가정·상가·사무실 등 다양한 현장에서 수거 상담을 진행합니다.`;
const types=data.types ?? ['가구·가전 수거','사무실 집기','상가·사업장 정리'];

const localLinks={
'중구':[['남포동','nampo'],['부평동','bupyeong']],
'동구':[['초량동','choryang'],['범일동','beomil']],
'영도구':[['동삼동','dongsam'],['청학동','cheonghak']],
'부산진구':[['서면','seomyeon'],['전포동','jeonpo'],['부암동','buam']],
'동래구':[['사직동','sajik'],['온천동','oncheon']],
'남구':[['대연동','daeyeon'],['용호동','yongho']],
'북구':[['화명동','hwamyeong'],['덕천동','deokcheon']],
'해운대구':[['우동','udong'],['좌동','jwadong'],['재송동','jaesong']],
'사하구':[['하단동','hadan'],['장림동','jangnim']],
'금정구':[['장전동','jangjeon'],['구서동','guseo']],
'강서구':[['명지동','myeongji'],['녹산동','noksan']],
'연제구':[['연산동','yeonsan'],['거제동','geoje']],
'수영구':[['광안동','gwangan'],['민락동','millak'],['남천동','namcheon']],
'사상구':[['감전동','gamjeon'],['괘법동','gwaebeop']],
'기장군':[['정관읍','jeonggwan'],['기장읍','gijang']]
};
const linkedPlaces=localLinks[area] ?? [];
const keywords=[area+' 폐기물수거',area+' 가구수거',area+' 사무실폐기물수거',area+' 상가폐기물수거',area+' 폐업정리',area+' 대량폐기물수거'];
---
<Layout title={area+' 폐기물수거 | 올바른수거'} description={'부산 '+area+' 폐기물수거. '+data.focus+' 상담. 사진으로 빠르게 수거 상담을 받아보세요.'}>
<header class="local-header"><a class="brand" href="/"><span class="logo">🚚</span><span><b>올바른수거</b><small>부산 폐기물·불용품 수거 전문</small></span></a><a href="/" class="back">← 부산 전체지역</a><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a></header>
<main>
<section class="area-hero district-hero"><div><p class="district-kicker">BUSAN · {area} COLLECTION GUIDE</p><h1>{area} 폐기물수거<br><em>{data.focus}</em></h1><p>{intro}</p><div class="district-facts"><span>사진으로 물품 확인</span><span>현장 이동조건 확인</span><span>{area} 지역별 안내</span></div><div class="actions"><a class="primary" href="#area-contact">사진으로 수거 상담</a><a class="secondary" href="tel:01066484886">☎ 전화 상담</a></div></div><div class="image-placeholder area-main-image"><strong>{area} 수거 안내 이미지</strong><span>지역 현장 WebP 이미지 교체 예정</span></div></section>
<section class="section local-intro"><p class="eyebrow-local">LOCAL GUIDE · {area}</p><h2>{area} 현장에 맞춘 수거 안내</h2><p>{intro}</p><div class="type-chips">{types.map(t=><span>{t}</span>)}</div></section>
<section class="section"><div class="section-head"><div><h2>{area} 주요 수거 서비스</h2><p>현장과 물품에 맞춰 필요한 수거 서비스를 상담합니다.</p></div></div><div class="keyword-grid">{keywords.map(k=><article><span>✓</span><strong>{k}</strong><p>사진과 수량을 알려주시면 빠르게 상담할 수 있습니다.</p></article>)}</div></section>
<section class="section local-places district-places"><p class="eyebrow-local">LOCAL AREA</p><h2>{area} 세부지역 수거 안내</h2><p>{data.places.join(' · ')} 등 {area} 지역별 정보를 확인해 보세요.</p><div>{data.places.map(p=>{const match=linkedPlaces.find(([name])=>name===p);return match?<a class="place-link" href={'/busan/local/'+match[1]}><small>{area}</small><b>{p} 폐기물수거</b><em>지역 안내 →</em></a>:<span class="place-pending"><small>{area}</small><b>{p} 폐기물수거</b><em>상담 가능</em></span>})}</div></section>
<section class="section"><div class="section-head"><div><h2>{area} 수거 사례</h2><p>실제 현장 이미지는 제작 후 순차적으로 교체합니다.</p></div></div><div class="cases">{[1,2,3,4].map(i=><article><div class="image-placeholder case-img"><span>{area} 현장 이미지 {i}</span></div><h3>{area} 수거 현장 {i}</h3><p>현장별 작업 내용을 독창적인 사례 콘텐츠로 구성할 예정입니다.</p></article>)}</div></section>
<section class="section faq local-faq"><h2>{area} 수거 FAQ</h2><details><summary>{area}에서 가구 한 개도 상담할 수 있나요?<span>＋</span></summary><p>수량이 적어도 물품 종류와 위치를 사진으로 보내주시면 수거 가능 여부를 확인할 수 있습니다.</p></details><details><summary>상가나 사무실을 한 번에 정리할 수 있나요?<span>＋</span></summary><p>집기 종류와 수량, 엘리베이터 및 주차 여건 등을 확인한 뒤 현장에 맞춰 상담합니다.</p></details><details><summary>먼저 사진으로 확인받을 수 있나요?<span>＋</span></summary><p>네. 전체 모습과 주요 물품이 보이도록 사진을 보내주시면 상담이 더 빠릅니다.</p></details></section>
<section id="area-contact" class="contact"><p>{area}에서 처리가 어려운 물품이 있으신가요?</p><h2>사진을 보내주시면 수거 가능 여부를 빠르게 상담해 드립니다.</h2><div class="actions"><a class="primary" href="#">카카오톡 사진 문의</a><a class="secondary" href="tel:01066484886">☎ 010-6648-4886</a></div></section>
</main>
<footer><b>올바른수거</b><p>부산 {area} 폐기물·불용품 수거 상담</p></footer><div class="mobile-bar"><a href="tel:01066484886">☎ 전화문의</a><a href="#area-contact">● 카톡문의</a></div>
</Layout>