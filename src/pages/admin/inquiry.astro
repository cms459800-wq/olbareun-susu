---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="문의 답변 | 올바른수거"><main class="board-page"><div class="board-hero"><span>ADMIN REQUEST</span><h1>수거 문의 답변</h1></div><section class="board-shell"><article class="board-detail" id="q"><div class="board-empty">불러오는 중입니다.</div></article><form class="board-form" id="rf" style="margin-top:18px"><label>관리자 답변<textarea name="admin_reply" rows="9" placeholder="답변을 입력하면 상태가 답변완료로 변경됩니다."></textarea></label><div class="form-actions"><a href="/admin/board">목록</a><button>답변 저장</button></div><p class="form-message"></p></form></section></main><script is:inline>
const API='https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/admin-board',t=localStorage.getItem('ob_admin_token');if(!t)location.href='/admin';const H={Authorization:'Bearer '+t,'Content-Type':'application/json'},id=new URLSearchParams(location.search).get('id'),q=document.querySelector('#q'),f=document.querySelector('#rf');fetch(API+'?action=inquiry-get&id='+id,{headers:H}).then(r=>r.json()).then(x=>{q.innerHTML='<div class="detail-head"><h2></h2><p></p></div><div class="detail-content"></div>';q.querySelector('h2').textContent=x.title;q.querySelector('p').textContent=x.author_name+' · '+new Date(x.created_at).toLocaleDateString('ko-KR')+' · '+x.status;q.querySelector('.detail-content').textContent=x.content;f.admin_reply.value=x.admin_reply||''});f.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch(API+'?action=inquiry-reply',{method:'POST',headers:H,body:JSON.stringify({id,admin_reply:f.admin_reply.value})});if(r.ok)location.href='/admin/board';else f.querySelector('.form-message').textContent='저장하지 못했습니다.'});
</script></Layout>