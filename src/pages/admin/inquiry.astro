---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="문의 답변 | 올바른수거"><header class="board-header"><a href="/" class="brand"><img class="brand-logo" src="/images/logo.png" alt="올바른수거" /></a><nav><a href="/">홈</a><a href="/notice">공지사항</a><a href="/inquiry">수거 문의</a></nav><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a><button class="board-menu" aria-label="메뉴 열기">☰</button></header><div class="board-mobile-nav"><a href="/">홈</a><a href="/notice">공지사항</a><a href="/inquiry">수거 문의</a><a href="tel:01066484886">전화 상담</a></div><main class="board-page"><div class="board-hero"><span>ADMIN REQUEST</span><h1>수거 문의 답변</h1></div><section class="board-shell"><article class="board-detail" id="q"><div class="board-empty">불러오는 중입니다.</div></article><form class="board-form" id="rf" style="margin-top:18px"><label>관리자 답변<textarea name="admin_reply" rows="9" placeholder="답변을 입력하면 상태가 답변완료로 변경됩니다."></textarea></label><div class="form-actions"><a href="/admin/board">목록</a><button>답변 저장</button></div><p class="form-message"></p></form></section></main><script is:inline>
const _bm=document.querySelector('.board-menu'),_bn=document.querySelector('.board-mobile-nav');_bm?.addEventListener('click',()=>_bn?.classList.toggle('open'));
const API='https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/admin-board',t=localStorage.getItem('ob_admin_token');if(!t)location.href='/admin';const H={Authorization:'Bearer '+t,'Content-Type':'application/json'},id=new URLSearchParams(location.search).get('id'),q=document.querySelector('#q'),f=document.querySelector('#rf');fetch(API+'?action=inquiry-get&id='+id,{headers:H}).then(r=>r.json()).then(x=>{q.innerHTML='<div class="detail-head"><h2></h2><p></p></div><div class="detail-content"></div>';q.querySelector('h2').textContent=x.title;q.querySelector('p').textContent=x.author_name+' · '+new Date(x.created_at).toLocaleDateString('ko-KR')+' · '+x.status;q.querySelector('.detail-content').textContent=x.content;f.admin_reply.value=x.admin_reply||''});f.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch(API+'?action=inquiry-reply',{method:'POST',headers:H,body:JSON.stringify({id,admin_reply:f.admin_reply.value})});if(r.ok)location.href='/admin/board';else f.querySelector('.form-message').textContent='저장하지 못했습니다.'});
</script><footer><b>올바른수거</b><p>부산 폐기물·불용품 수거 상담 · 010-6648-4886</p></footer></Layout>