---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="공지 관리 | 올바른수거"><main class="board-page"><div class="board-hero"><span>ADMIN NOTICE</span><h1>공지사항 작성·수정</h1></div><section class="board-shell"><form class="board-form" id="nf"><input type="hidden" name="id"><label>제목<input name="title" maxlength="200" required></label><label>조회수<input name="views" type="number" min="0" value="0" required><small>원하는 숫자로 직접 변경할 수 있습니다. 이후 실제 열람 시 자동으로 증가합니다.</small></label><label>공지 내용<textarea name="content" rows="13" required></textarea></label><label class="check-label"><input type="checkbox" name="is_published" checked> 공개</label><div class="form-actions"><button type="button" class="danger" id="del" hidden>공지 삭제</button><a href="/admin/board">취소</a><button>저장</button></div><p class="form-message"></p></form></section></main><script is:inline>
const API='https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/admin-board',t=localStorage.getItem('ob_admin_token');if(!t)location.href='/admin';const H={Authorization:'Bearer '+t,'Content-Type':'application/json'},f=document.querySelector('#nf'),id=new URLSearchParams(location.search).get('id'),m=f.querySelector('.form-message'),del=document.querySelector('#del');if(id){del.hidden=false;fetch(API+'?action=notice-get&id='+id,{headers:H}).then(r=>r.json()).then(x=>{f.id.value=x.id;f.title.value=x.title;f.views.value=x.views;f.content.value=x.content;f.is_published.checked=x.is_published})}f.addEventListener('submit',async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(f));x.id=id||null;x.views=Number(x.views);x.is_published=f.is_published.checked;const r=await fetch(API+'?action=notice-save',{method:'POST',headers:H,body:JSON.stringify(x)});if(r.ok)location.href='/admin/board';else m.textContent='저장하지 못했습니다.'});del.onclick=async()=>{if(!confirm('이 공지를 삭제할까요?'))return;const r=await fetch(API+'?action=notice-delete',{method:'POST',headers:H,body:JSON.stringify({id})});if(r.ok)location.href='/admin/board'};
</script></Layout>