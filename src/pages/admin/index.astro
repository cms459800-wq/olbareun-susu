<Layout title="관리자 로그인 | 올바른수거"><header class="board-header"><a href="/" class="brand"><img class="brand-logo" src="/images/logo.png" alt="올바른수거" /></a><nav><a href="/">홈</a><a href="/notice">공지사항</a><a href="/inquiry">수거 문의</a></nav><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a><button class="board-menu" aria-label="메뉴 열기">☰</button></header><div class="board-mobile-nav"><a href="/">홈</a><a href="/notice">공지사항</a><a href="/inquiry">수거 문의</a><a href="tel:01066484886">전화 상담</a></div><main class="board-page"><div class="board-hero"><span>ADMIN</span><h1>관리자 접속</h1><p>올바른수거 게시판 관리</p></div><section class="board-shell"><form class="secret-box" id="admin-login"><label>이메일<input type="email" name="email" required autocomplete="username"></label><label>비밀번호<input type="password" name="password" required autocomplete="current-password"></label><button>로그인</button><a href="/">홈으로</a><p class="form-message"></p></form></section></main><script is:inline>
const _bm=document.querySelector('.board-menu'),_bn=document.querySelector('.board-mobile-nav');_bm?.addEventListener('click',()=>_bn?.classList.toggle('open'));
const URL='https://dctolxhyifismoxjqtrk.supabase.co',KEY='sb_publishable_Zaa5aBWyZNymB8xWX611HQ_rmXYbZAu',f=document.querySelector('#admin-login'),m=f.querySelector('.form-message');f.addEventListener('submit',async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(f));const r=await fetch(URL+'/auth/v1/token?grant_type=password',{method:'POST',headers:{apikey:KEY,'Content-Type':'application/json'},body:JSON.stringify(x)});const j=await r.json();if(!r.ok){m.textContent='로그인 정보를 확인해 주세요.';return}localStorage.setItem('ob_admin_token',j.access_token);location.href='/admin/board';});
</script><footer><b>올바른수거</b><p>부산 폐기물·불용품 수거 상담 · 010-6648-4886</p></footer></Layout>