---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="게시판 관리 | 올바른수거"><main class="board-page"><div class="board-hero"><span>ADMIN</span><h1>게시판 관리</h1></div><section class="board-shell"><div class="board-tools"><b>공지사항</b><a class="board-write" href="/admin/notice-edit">공지 작성</a></div><div class="board-table board-notice" id="admin-notices"><div class="board-empty">불러오는 중입니다.</div></div><div class="board-tools" style="margin-top:40px"><b>수거 문의</b><button class="back-list" id="logout">로그아웃</button></div><div class="board-table board-inquiry" id="admin-inquiries"></div></section></main><script is:inline>
const API='https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/admin-board',t=localStorage.getItem('ob_admin_token');if(!t)location.href='/admin';const h={Authorization:'Bearer '+t};fetch(API+'?action=dashboard',{headers:h}).then(async r=>{if(r.status===401||r.status===403){localStorage.removeItem('ob_admin_token');location.href='/admin';return}const j=await r.json(),n=document.querySelector('#admin-notices'),q=document.querySelector('#admin-inquiries');n.innerHTML='<div class="board-row board-th"><span>번호</span><span>제목</span><span>작성일</span><span>조회</span></div>';j.notices.forEach(x=>n.insertAdjacentHTML('beforeend','<a class="board-row" href="/admin/notice-edit?id='+x.id+'"><span>'+x.id+'</span><strong></strong><span>'+new Date(x.created_at).toLocaleDateString('ko-KR')+'</span><span>'+x.views+'</span></a>'));[...n.querySelectorAll('strong')].forEach((e,i)=>e.textContent=j.notices[i].title);q.innerHTML='<div class="board-row board-th"><span>번호</span><span>제목</span><span>작성자</span><span>작성일</span><span>상태</span></div>';j.inquiries.forEach(x=>q.insertAdjacentHTML('beforeend','<a class="board-row" href="/admin/inquiry?id='+x.id+'"><span>'+x.id+'</span><strong></strong><span></span><span>'+new Date(x.created_at).toLocaleDateString('ko-KR')+'</span><span class="board-status">'+x.status+'</span></a>'));[...q.querySelectorAll('.board-row:not(.board-th)')].forEach((e,i)=>{e.querySelector('strong').textContent=j.inquiries[i].title;e.children[2].textContent=j.inquiries[i].author_name})});document.querySelector('#logout').onclick=()=>{localStorage.removeItem('ob_admin_token');location.href='/admin'};
</script></Layout>