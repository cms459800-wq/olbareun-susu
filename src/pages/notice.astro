---
import Layout from '../layouts/Layout.astro';
---
<Layout title="공지사항 | 올바른수거" description="올바른수거 서비스 공지사항과 이용 안내를 확인하세요.">
<header class="board-header"><a href="/" class="brand"><img class="brand-logo" src="/images/logo.png" alt="올바른수거" /></a><nav><a class="active" href="/notice">공지사항</a><a href="/inquiry">수거 문의</a></nav><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a><button class="board-menu" aria-label="메뉴 열기">☰</button></header>
<div class="board-mobile-nav"><a href="/">홈</a><a href="/notice">공지사항</a><a href="/inquiry">수거 문의</a><a href="tel:01066484886">전화 상담</a></div>
<main class="board-page"><div class="board-hero"><span>CUSTOMER CENTER</span><h1>공지사항</h1><p>올바른수거의 새로운 소식과 이용 안내를 확인하세요.</p></div><div class="board-tabs"><a class="active" href="/notice">공지사항</a><a href="/inquiry">수거 문의</a></div><section class="board-shell"><div class="board-table board-notice" id="notice-list"><div class="board-row board-th"><span>번호</span><span>제목</span><span>작성일</span><span>조회</span></div><div class="board-empty">공지사항을 불러오는 중입니다.</div></div></section></main>
<footer><b>올바른수거</b><p>부산 폐기물·불용품 수거 상담 · 010-6648-4886</p></footer>
<script is:inline>
const b=document.querySelector('.board-menu'),n=document.querySelector('.board-mobile-nav');b?.addEventListener('click',()=>n?.classList.toggle('open'));
const box=document.querySelector('#notice-list');fetch('https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/public-board?action=notices').then(r=>r.json()).then(rows=>{const head=box.firstElementChild;box.innerHTML='';box.append(head);if(!rows.length){box.insertAdjacentHTML('beforeend','<div class="board-empty">등록된 공지사항이 없습니다.</div>');return}rows.forEach((x,i)=>{const a=document.createElement('a');a.className='board-row';a.href='/notice/view?id='+x.id;a.innerHTML='<span>'+(rows.length-i)+'</span><strong></strong><span>'+new Date(x.created_at).toLocaleDateString('ko-KR')+'</span><span>'+x.views+'</span>';a.querySelector('strong').textContent=x.title;box.append(a)})}).catch(()=>box.querySelector('.board-empty').textContent='목록을 불러오지 못했습니다.');
</script>
</Layout>