---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="수거 문의 작성 | 올바른수거" description="올바른수거 비밀 문의 작성">
<main class="board-page"><div class="board-hero"><span>PRIVATE REQUEST</span><h1>수거 문의 작성</h1><p>작성한 글은 비밀번호로 보호됩니다.</p></div>
<section class="board-shell"><form class="board-form" id="inquiry-form"><label>제목<input name="title" maxlength="200" required placeholder="예: 사무실 폐기물 수거 문의"></label><label>작성자<input name="author_name" maxlength="50" required placeholder="이름 또는 업체명"></label><label>비밀번호<input name="password" type="password" minlength="4" required placeholder="4자 이상"></label><label>문의 내용<textarea name="content" rows="10" maxlength="10000" required placeholder="수거 품목, 대략적인 수량, 지역, 층수 등을 적어주세요."></textarea></label><div class="form-actions"><a href="/inquiry">취소</a><button type="submit">문의 등록</button></div><p class="form-message" aria-live="polite"></p></form></section></main>
<script is:inline>
const f=document.querySelector('#inquiry-form'),m=f.querySelector('.form-message');f.addEventListener('submit',async e=>{e.preventDefault();const btn=f.querySelector('button');btn.disabled=true;m.textContent='등록 중입니다.';const data=Object.fromEntries(new FormData(f));try{const r=await fetch('https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/public-board?action=inquiry-create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const j=await r.json();if(!r.ok)throw new Error(j.error);location.href='/inquiry/view?id='+j.id}catch(err){m.textContent=err.message||'등록하지 못했습니다.';btn.disabled=false}});
</script></Layout>