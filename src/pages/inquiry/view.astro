---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="수거 문의 확인 | 올바른수거" description="비밀 수거 문의 확인">
<main class="board-page"><div class="board-hero"><span>PRIVATE REQUEST</span><h1>비밀글입니다.</h1><p>작성할 때 설정한 비밀번호를 입력해 주세요.</p></div><section class="board-shell"><div class="secret-box" id="secret-box"><form id="unlock"><label>비밀번호<input type="password" name="password" required autofocus></label><button>확인</button><a href="/inquiry">목록으로</a><p class="form-message"></p></form></div><article class="board-detail" id="detail" hidden><div class="detail-head"><h2></h2><p></p></div><div class="detail-content"></div><div class="admin-reply" hidden><b>올바른수거 답변</b><p></p></div><a class="back-list" href="/inquiry">목록으로</a></article></section></main>
<script is:inline>
const id=new URLSearchParams(location.search).get('id'),f=document.querySelector('#unlock'),msg=f.querySelector('.form-message'),box=document.querySelector('#secret-box'),d=document.querySelector('#detail');f.addEventListener('submit',async e=>{e.preventDefault();const password=new FormData(f).get('password');const r=await fetch('https://dctolxhyifismoxjqtrk.supabase.co/functions/v1/public-board?action=inquiry-read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,password})});const j=await r.json();if(!r.ok){msg.textContent=j.error||'확인하지 못했습니다.';return}box.hidden=true;d.hidden=false;d.querySelector('h2').textContent=j.title;d.querySelector('.detail-head p').textContent=j.author_name+' · '+new Date(j.created_at).toLocaleDateString('ko-KR')+' · '+j.status;d.querySelector('.detail-content').textContent=j.content;if(j.admin_reply){const a=d.querySelector('.admin-reply');a.hidden=false;a.querySelector('p').textContent=j.admin_reply}});
</script></Layout>