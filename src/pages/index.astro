];

const websiteJson={'@context':'https://schema.org','@type':'WebSite',name:'올바른수거',inLanguage:'ko-KR'};
const homeFaqJson={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
{'@type':'Question',name:'수거 비용은 어떻게 정해지나요?',acceptedAnswer:{'@type':'Answer',text:'품목 종류와 수량·부피, 층수와 엘리베이터, 차량 접근 등 현장 조건을 확인한 뒤 상담합니다.'}},
{'@type':'Question',name:'사진으로 먼저 상담할 수 있나요?',acceptedAnswer:{'@type':'Answer',text:'네. 전체 물량과 큰 물품이 잘 보이는 사진에 수량과 건물 조건을 함께 알려주시면 확인에 도움이 됩니다.'}},
{'@type':'Question',name:'가구 한두 개도 문의할 수 있나요?',acceptedAnswer:{'@type':'Answer',text:'물품 사진과 크기, 현장 위치 및 이동 조건을 보내주시면 수거 가능 여부를 확인할 수 있습니다.'}},
{'@type':'Question',name:'사무실·상가·창고처럼 물량이 많아도 되나요?',acceptedAnswer:{'@type':'Answer',text:'전체 물량이 보이는 사진과 주요 품목의 대략적인 수량, 차량 진입 가능 여부를 알려주세요.'}},
{'@type':'Question',name:'문의할 때 어떤 정보를 준비하면 되나요?',acceptedAnswer:{'@type':'Answer',text:'수거할 물품 사진, 대략적인 수량, 층수·엘리베이터 여부, 차량 접근 가능 여부를 준비하면 좋습니다.'}}
]};
---
<Layout>
<header class="main-header"><a class="brand" href="/" aria-label="올바른수거 홈"><img class="brand-logo" src="/images/logo.png" alt="올바른수거" width="320" height="100" /></a><nav class="desktop-nav"><a href="#services">수거품목</a><a href="#steps">수거방법</a><a href="#areas">부산지역</a><a href="#cases">상담예시</a><a href="#faq">FAQ</a></nav><a class="header-call" href="tel:01066484886">☎ 010-6648-4886</a><button class="menu" type="button" aria-label="전체 메뉴 열기" aria-expanded="false">☰</button></header>
<div class="mobile-menu" aria-hidden="true"><div class="mobile-menu-head"><strong>전체 메뉴</strong><button class="menu-close" type="button" aria-label="전체 메뉴 닫기">×</button></div><nav><a href="#services"><span>수거 가능 품목</span><em>→</em></a><a href="#steps"><span>수거 방법</span><em>→</em></a><a href="#areas"><span>부산 지역 안내</span><em>→</em></a><a href="#cases"><span>수거 상담 예시</span><em>→</em></a><a href="#faq"><span>자주 묻는 질문</span><em>→</em></a></nav><div class="mobile-menu-contact"><small>사진을 준비하셨다면</small><a href="#contact">사진으로 수거 상담하기</a><a href="tel:01066484886">☎ 010-6648-4886</a></div></div><div class="menu-dim"></div>
<main>
<section class="hero"><div class="hero-copy"><p class="eyebrow">BUSAN · PHOTO CONSULTATION</p><h1>버리기 어려운 물품,<br><em>사진부터 보내주세요.</em></h1><p>부산 가정·이사·사무실·상가·사업장까지<br>물품과 현장 조건을 확인해 수거 상담을 도와드립니다.</p><div class="hero-mini"><b>01 사진 촬영</b><span>→</span><b>02 현장 확인</b><span>→</span><b>03 수거 상담</b></div><div class="trust"><span>⌖ 부산 전지역 방문상담</span><span>▣ 사진으로 간편견적</span><span>▤ 가정·사무실·상가·사업장</span></div><div class="actions"><a class="primary" href="#contact">● 사진으로 수거 문의하기</a><a class="secondary" href="tel:01066484886">☎ 전화 상담하기</a></div></div><div class="hero-chat" aria-label="올바른수거 사진 상담 예시">
  <div class="chat-phone">
    <div class="phone-screen">
      <div class="phone-status"><span>9:41</span><div class="dynamic-island"></div><div class="status-icons"><i class="signal"></i><i class="wifi"></i><i class="battery"></i></div></div>
    <div class="chat-head"><img src="/images/logo.png" alt="" /><div><b>올바른수거</b><span><i></i> 상담 가능</span></div></div>
    <div class="chat-body multi-chat">
      <div class="scene scene-1"><div class="chat-day">이사 폐기물 상담</div><div class="chat-row customer"><div class="bubble">이사 후 남은 소파와 TV,<br>생활가전 정리하고 싶어요.</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>소파 · TV · 생활가전</b><small>사진 3장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">올바른수거입니다. 사진과 수량을 확인해볼게요.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>이사 폐기물 · 예상 비용</span><strong>10만원~</strong><small>소파·TV 등 품목과 수량, 현장 조건에 따라 달라집니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <div class="scene scene-2"><div class="chat-day">사업장 폐기물 상담</div><div class="chat-row customer"><div class="bubble">공장 이전 중인데 기계 주변 불용품과<br>사업장 폐기물이 많이 있습니다.</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>사업장 전체 물량</b><small>사진 4장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">종류와 전체 물량, 차량 진입 조건을 함께 확인하겠습니다.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>사업장 폐기물 · 예상 비용</span><strong>45만원~</strong><small>폐기물 종류·무게·작업 조건에 따라 달라집니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <div class="scene scene-3"><div class="chat-day">철거 잔재물 상담</div><div class="chat-row customer"><div class="bubble">인테리어 철거 뒤 잔재물이 남았어요.<br>한 번에 정리할 수 있을까요?</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>철거 잔재물</b><small>사진 3장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">현장 사진과 잔재물 양을 보내주시면 확인해드릴게요.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>철거 잔재물 · 예상 비용</span><strong>20만원~</strong><small>물량과 층수·접근 조건에 따라 달라집니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <div class="scene scene-4"><div class="chat-day">가정 폐기물 상담</div><div class="chat-row customer"><div class="bubble">쇼파랑 냉장고를 정리하려고 합니다.<br>같이 수거할 수 있나요?</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>소파 · 냉장고</b><small>사진 2장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">네. 가구·가전 사진과 층수를 함께 확인하겠습니다.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>가정 폐기물 · 예상 비용</span><strong>8만원~</strong><small>품목과 층수, 이동 조건에 따라 달라집니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <div class="scene scene-5"><div class="chat-day">폐기물 처리 상담</div><div class="chat-row customer"><div class="bubble">여러 종류의 폐기물이 섞여 있는데<br>처리 상담 가능할까요?</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>혼합 폐기물 전체</b><small>사진 3장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">가능 여부를 확인할 수 있도록 전체 사진을 보내주세요.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>폐기물 처리 · 예상 비용</span><strong>15만원~</strong><small>현장 상태와 처리 품목에 따라 달라질 수 있습니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <div class="scene scene-6"><div class="chat-day">유품정리 상담</div><div class="chat-row customer"><div class="bubble">고인이 남기신 물품과 가구를<br>정리해야 해서 문의드립니다.</div></div><div class="chat-row customer"><div class="chat-photo-msg"><div class="photo-preview">사진</div><div><b>가구 · 생활물품</b><small>사진 4장 전송</small></div></div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble">물품을 확인하고 조심스럽게 상담해드리겠습니다.</div></div><div class="chat-row brand-row"><div class="chat-avatar">올</div><div class="bubble quote-bubble"><span>유품정리 · 예상 비용</span><strong>30만원~</strong><small>공간과 물량에 따라 상담 금액이 달라질 수 있습니다.</small><p>주소를 알려주시면 바로 수거해드리겠습니다.</p></div></div></div>
      <a class="scene-kakao" href="http://qr.kakao.com/talk/xiB5oLU91AZmWwLV9g5AwwM4O5I-" target="_blank" rel="noopener noreferrer">카카오톡 상담하기 →</a>
    </div>
      <div class="home-indicator"></div>
    </div>
    <span class="phone-button phone-button-a"></span><span class="phone-button phone-button-b"></span><span class="phone-button phone-button-c"></span>
  </div>
  <div class="chat-float chat-float-a">사진으로 간편하게</div>
  <div class="chat-float chat-float-b">부산 전지역 상담</div>
</div></section>
<section class="quick-proof"><div><b>사진으로 먼저 확인</b><span>물품 전체와 수량이 보이게 촬영</span></div><div><b>현장조건 함께 확인</b><span>층수·엘리베이터·차량 접근 여부</span></div><div><b>부산 지역별 안내</b><span>구·군과 주요 동네별 수거 정보</span></div><div><b>다량 물품 상담</b><span>사무실·상가·사업장·창고 정리</span></div></section>
<section class="section consult-guide"><div class="section-head"><div><p class="eyebrow-local">PHOTO CONSULT</p><h2>사진 상담, 이렇게 보내주세요</h2><p>처음 문의할 때 아래 4가지만 확인하면 상담이 훨씬 간단해집니다.</p></div></div><div class="consult-grid"><article><b>01</b><strong>전체 사진</strong><p>수거할 물품이 한눈에 보이도록 전체 모습을 촬영해 주세요.</p></article><article><b>02</b><strong>품목·수량</strong><p>가구, 가전, 사무집기 등 종류와 대략적인 개수를 알려주세요.</p></article><article><b>03</b><strong>건물 조건</strong><p>층수와 엘리베이터 사용 가능 여부를 함께 알려주세요.</p></article><article><b>04</b><strong>차량 접근</strong><p>건물 앞 정차나 주차 가능 여부를 알려주시면 확인에 도움이 됩니다.</p></article></div></section>
<section id="services" class="section"><div class="section-head"><div><h2>수거 가능 품목</h2><p>가정부터 사업장까지 다양한 폐기물을 상담합니다.</p></div><a href="#contact">전체보기 →</a></div><div class="service-grid">{services.map(([name,desc],i)=><article class="service-card"><div class="image-placeholder card-img"><span>이미지 {String(i+1).padStart(2,'0')}</span></div><h3>{name}</h3><p>{desc}</p></article>)}</div></section>
<section class="section estimate-calculator" id="estimate-calculator">
  <div class="estimate-head"><span>QUICK ESTIMATE</span><h2>내 상황에 맞는 <em>예상 수거비용</em>을 확인해보세요</h2><p>아래 항목을 차례로 선택하면 참고용 예상금액을 바로 확인할 수 있습니다.</p></div>
  <div class="estimate-panel">
    <div class="estimate-step"><div class="estimate-step-title"><b>01</b><div><small>수거 규모</small><h3>차량·물량을 선택해 주세요</h3></div></div><div class="estimate-options" data-group="volume">
      <button type="button" class="estimate-option active" data-price="50000"><span>🧺</span><b>소량 수거</b><small>5만원~</small></button>
      <button type="button" class="estimate-option" data-price="200000"><span>🛻</span><b>0.5톤 내외</b><small>20만원~</small></button>
      <button type="button" class="estimate-option" data-price="400000"><span>🚚</span><b>1톤 차량</b><small>40만원~</small></button>
      <button type="button" class="estimate-option" data-price="700000"><span>🚛</span><b>대량 수거</b><small>70만원~</small></button>
      <button type="button" class="estimate-option" data-price="1200000"><span>🏭</span><b>사업장 대량</b><small>120만원~</small></button>
    </div></div>
    <div class="estimate-step"><div class="estimate-step-title"><b>02</b><div><small>폐기물 종류</small><h3>가장 가까운 유형을 골라주세요</h3></div></div><div class="estimate-options" data-group="type">
      <button type="button" class="estimate-option active" data-price="0"><span>🛋️</span><b>가구·생활</b><small>기본</small></button>
      <button type="button" class="estimate-option" data-price="30000"><span>🧊</span><b>냉장고·쇼케이스</b><small>+3만원~</small></button>
      <button type="button" class="estimate-option" data-price="20000"><span>💻</span><b>폐컴퓨터·사무집기</b><small>+2만원~</small></button>
      <button type="button" class="estimate-option" data-price="50000"><span>🧱</span><b>철거 잔재물</b><small>+5만원~</small></button>
      <button type="button" class="estimate-option" data-price="100000"><span>🏗️</span><b>사업장 폐기물</b><small>+10만원~</small></button>
